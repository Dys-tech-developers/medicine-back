NODE_ENV=development
PORT=3000
# SQLite local (sin servidor). El archivo se crea en prisma/dev.db
DATABASE_URL="file:./dev.db"
# Cuando tengas PostgreSQL, cambiá provider en schema.prisma a postgresql y usá por ejemplo:
# DATABASE_URL="postgresql://usuario:password@localhost:5432/medicine_db?schema=public"
JWT_SECRET="cambiar_por_secreto_largo_minimo_32_caracteres_prod"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=12
# Orígenes extra del frontend (separados por coma). En development también se permiten
# localhost y cualquier *.ngrok-free.app / *.ngrok.io (túnel móvil).
# CORS_ORIGINS=http://localhost:5173,https://tu-subdominio.ngrok-free.app
# TRUST_PROXY=true
