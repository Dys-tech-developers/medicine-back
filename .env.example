NODE_ENV=development
PORT=3000
# MariaDB / MySQL (Prisma usa el connector "mysql" para ambos)
DATABASE_URL="mysql://usuario:password@localhost:3306/medicine_dev"
JWT_SECRET="cambiar_por_secreto_largo_minimo_32_caracteres_prod"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
RESET_CODE_EXPIRES_IN="30m"
BCRYPT_SALT_ROUNDS=12
# Orígenes extra del frontend (separados por coma). En development también se permiten
# localhost y cualquier *.ngrok-free.app / *.ngrok.io (túnel móvil).
# CORS_ORIGINS=http://localhost:5173,https://8a41-181-230-197-220.ngrok-free.app
# TRUST_PROXY=true
# Secreto para POST /api/v1/internal/cron/cerrar-visitas-vencidas (Authorization: Bearer ...)
# CRON_SECRET="cambiar_por_secreto_largo_minimo_32_caracteres_cron"
# SMTP para envío de correos (recuperación de contraseña). En development, si no
# se configura, el código se imprime por consola. En production es obligatorio.
# Puerto 587 => STARTTLS (secure=false). Puerto 465 => TLS implícito (secure=true).
# SMTP_HOST=smtp.dysassistance.com
# SMTP_PORT=587
# SMTP_USER=no-reply@dysassistance.com
# SMTP_PASS=tu_password_smtp
# MAIL_FROM="DYS Medicine <no-reply@dysassistance.com>"
