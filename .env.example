NODE_ENV=development
PORT=3000
# PostgreSQL (Neon, VPS, Docker local, etc.)
DATABASE_URL="postgresql://usuario:password@localhost:5432/medicine_dev?schema=public"
# Neon: usar sslmode=require. Migraciones: preferir connection string "direct" (sin -pooler).
JWT_SECRET="cambiar_por_secreto_largo_minimo_32_caracteres_prod"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
RESET_CODE_EXPIRES_IN="30m"
BCRYPT_SALT_ROUNDS=12
